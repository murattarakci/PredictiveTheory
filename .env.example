# Copy to .env and fill in. Never commit .env, and never put these values in code.
# On shinyapps.io, set them under the app's Settings > Vars instead.

# Dropbox app credentials (Dropbox App Console > your app > Settings)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Long-lived refresh token from the OAuth 2 flow
DROPBOX_REFRESH_TOKEN=

# Optional legacy short-lived access token (expires after about 4 hours)
# DROPBOX_ACCESS_TOKEN=

# Remote path; for "App folder" apps, / is the app root (default: /poc.db)
# DROPBOX_REMOTE_DB_PATH=/poc.db

# Folder in Dropbox that mirrors local ./data (user/repo/*.csv, analysis files)
# DROPBOX_REMOTE_DATA_PREFIX=/data
