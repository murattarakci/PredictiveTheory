# Copy to .env and fill in. Never commit .env.

# Required for Dropbox DB sync (generate in Dropbox App Console)
DROPBOX_ACCESS_TOKEN=

# Remote path; for "App folder" apps, / is the app root (default: /poc.db)
# DROPBOX_REMOTE_DB_PATH=/poc.db

# Folder in Dropbox that mirrors local ./data (user/repo/*.csv, analysis files)
# DROPBOX_REMOTE_DATA_PREFIX=/data
